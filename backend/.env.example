# ── Server ──
PORT=5000
NODE_ENV=development
CLIENT_URL=http://127.0.0.1:5500

# ── MongoDB Atlas ──
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lasu-connect?retryWrites=true&w=majority

# ── JWT ──
JWT_SECRET=replace_with_a_long_random_secret_string_minimum_32_chars
JWT_EXPIRES_IN=30d

# ── Nodemailer (Gmail) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=lasuconnect.app@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_FROM=LASU Connect <lasuconnect.app@gmail.com>

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Redis (Upstash) ──
REDIS_URL=redis://default:your_password@your-instance.upstash.io:6379
